{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Verglas",
	"description": "Build serverless Workers, Durable Objects, and data pipelines on Verglas.",
	"colors": {
		"primary": "#1464F4",
		"light": "#5EEAD4",
		"dark": "#3B82F6"
	},
	"logo": {
		"light": "/docs/assets/verglas-mark.png",
		"dark": "/docs/assets/verglas-mark.png",
		"href": "https://verglas.dev"
	},
	"favicon": "/docs/assets/verglas-favicon.png",
	"fonts": {
		"family": "IBM Plex Sans"
	},
	"icons": {
		"library": "lucide"
	},
	"background": {
		"color": {
			"light": "#F6F9FF",
			"dark": "#0B0F14"
		}
	},
	"thumbnails": {
		"appearance": "dark",
		"background": "/docs/assets/verglas-banner.png"
	},
	"appearance": {
		"default": "system"
	},
	"navigation": {
		"groups": [
			{
				"group": "Get started",
				"icon": "rocket",
				"pages": [
					"docs/index",
					"docs/get-started/quickstart",
					"docs/get-started/notebooks"
				]
			},
			{
				"group": "Concepts",
				"icon": "blocks",
				"pages": ["docs/concepts/platform", "docs/concepts/scheduled-workers"]
			},
			{
				"group": "Built-ins",
				"icon": "database",
				"pages": [
					"docs/built-ins/overview",
					"docs/built-ins/durable-objects",
					"docs/built-ins/streams-pipelines",
					"docs/built-ins/catalog-query",
					"docs/built-ins/vectorize",
					"docs/built-ins/graph"
				]
			},
			{
				"group": "Recipes",
				"icon": "book-open",
				"pages": [
					"docs/recipes/overview",
					"docs/recipes/webhook-to-lakehouse",
					"docs/recipes/deduplicate-events",
					"docs/recipes/medallion-pipeline",
					"docs/recipes/semantic-search"
				]
			}
		]
	},
	"navbar": {
		"links": [
			{
				"type": "github",
				"label": "GitHub",
				"href": "https://github.com/verglas-org/verglas-sdk"
			}
		],
		"primary": {
			"type": "button",
			"label": "Get started",
			"href": "/docs/get-started/quickstart"
		}
	},
	"footer": {
		"socials": {
			"github": "https://github.com/verglas-org/verglas-sdk"
		}
	},
	"styling": {
		"eyebrows": "breadcrumbs"
	}
}
