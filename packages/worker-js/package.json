		},
		"./cloudflare-workers": "./src/cloudflare-workers.js"
	},
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"prepack": "npm test"
	},
	"dependencies": {
		"@bytecodealliance/componentize-js": "0.22.0",
